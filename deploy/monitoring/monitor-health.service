[Unit]
Description=Minimal Sub2API CPA host health monitor
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
EnvironmentFile=/etc/sub2api-monitor.env
ExecStart=/usr/bin/python3 /usr/local/libexec/sub2api-monitor.py --health
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/sub2api-monitor
